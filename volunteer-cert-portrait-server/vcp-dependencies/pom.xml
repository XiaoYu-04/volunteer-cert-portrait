<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      本模块为独立 BOM，刻意不继承聚合根 pom。
      若在此声明 parent 为 volunteer-cert-portrait-server，会与根 pom 的
      dependencyManagement 导入形成循环依赖，Maven 将直接拒绝读取整个工程。
    -->
    <groupId>com.vcp</groupId>
    <artifactId>vcp-dependencies</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>vcp-dependencies</name>
    <description>依赖版本统一管理（BOM）：三方依赖 + 内部模块</description>

    <properties>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <sa-token.version>1.46.0</sa-token.version>
        <hutool.version>5.8.47</hutool.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <knife4j-next.version>5.7.5</knife4j-next.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ==================== 三方依赖 ==================== -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- 分页插件必需依赖（3.5.9+ 起单独引入） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot4-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- 接口文档（Knife4j Next，Spring Boot 4 专用 starter） -->
            <dependency>
                <groupId>com.baizhukui</groupId>
                <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
                <version>${knife4j-next.version}</version>
            </dependency>

            <!-- ==================== 内部模块 ==================== -->
            <dependency>
                <groupId>com.vcp</groupId>
                <artifactId>vcp-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vcp</groupId>
                <artifactId>vcp-framework</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vcp</groupId>
                <artifactId>vcp-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vcp</groupId>
                <artifactId>vcp-org</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vcp</groupId>
                <artifactId>vcp-volunteer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vcp</groupId>
                <artifactId>vcp-certification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vcp</groupId>
                <artifactId>vcp-portrait</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vcp</groupId>
                <artifactId>vcp-analytics</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>