<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.vcp</groupId>
        <artifactId>volunteer-cert-portrait-server</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>vcp-framework</artifactId>
    <name>vcp-framework</name>
    <description>框架基础设施模块：安全认证、全局异常、ORM 配置、日志、跨域</description>

    <dependencies>
        <dependency>
            <groupId>com.vcp</groupId>
            <artifactId>vcp-common</artifactId>
        </dependency>

        <!-- Web / AOP / 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ORM：MyBatis-Plus（Boot4 专用 starter）+ 分页依赖 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- 认证鉴权：Sa-Token（Boot4 专用 starter） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot4-starter</artifactId>
        </dependency>

        <!-- 口令哈希：只取 Spring Security 的 crypto 模块（BCryptPasswordEncoder）。
             刻意不引 spring-boot-starter-security —— 登录鉴权由 Sa-Token 承担，
             引入 starter 会额外装配一套过滤器链与默认登录页，与本工程的接口路由冲突。
             版本由 spring-boot-starter-parent 的 BOM 管理（属性 spring-security.version），
             因此 vcp-dependencies 里不需要再写一条 dependencyManagement。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- PostgreSQL 驱动（运行时） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 接口文档：Knife4j Next（Spring Boot 4 专用 starter），访问 /doc.html；需配合 knife4j.enable=true 生效 -->
        <dependency>
            <groupId>com.baizhukui</groupId>
            <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
