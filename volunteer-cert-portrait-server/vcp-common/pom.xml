<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.vcp</groupId>
        <artifactId>volunteer-cert-portrait-server</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>vcp-common</artifactId>
    <name>vcp-common</name>
    <description>公共基础模块：统一返回、异常体系、常量、枚举、工具类</description>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <!-- MyBatis-Plus 注解包（只有注解，不含 ORM 实现）：
             BaseEntity 需要用 @TableField(fill = ...) 声明 create_time/update_time 自动填充，
             否则 vcp-framework 的 MetaObjectHandler 不会对这两个字段生效。
             本模块不碰数据库，只提供公共基类。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-annotation</artifactId>
        </dependency>
    </dependencies>
</project>