# =============================================================
# 后端服务单元（systemd）
#
# 放到 /etc/systemd/system/vcp.service，然后：
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now vcp
#   sudo systemctl status vcp
#   sudo journalctl -u vcp -f          # 看日志
#
# 本文件**不含任何口令**，可以入库。凭证走下面 EnvironmentFile 指的那个文件。
# 完整部署步骤与验收清单见 docs/部署文档.md。
# =============================================================

[Unit]
Description=高校志愿服务时长认证与公益画像数据分析系统（后端）
# 前提：docs/ 已按部署文档 4.2 拷到 /opt/vcp/docs/。没拷的话这行只是条失效提示，不影响启动。
Documentation=file:/opt/vcp/docs/部署文档.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vcp
Group=vcp

# jar 与它同级的 config/ 放这里。
# 后端启动脚本默认从「启动目录」找 ./config/application-local.yml，
# 见 application.yml 的 spring.config.import 第四条 —— 与 WorkingDirectory 配合生效。
WorkingDirectory=/opt/vcp

# 数据库凭证：VCP_DB_USERNAME / VCP_DB_PASSWORD 两行，文件权限建议 600、属主 vcp。
# 这是**推荐做法** —— 比写 application-local.yml 更不容易被误提交进仓库。
# 也可以改用 /opt/vcp/config/application-local.yml（application.yml 的 import 已支持），
# 二者取其一即可；环境变量优先级更高。
# 注意：口令在文件里要**加引号**，以 0 开头的数字串会被 YAML 当八进制解析（012345 → 5349）。
EnvironmentFile=/opt/vcp/vcp.env

# prod profile 做三处上线收口（见 application-prod.yml）：
#   ① 跨域来源由 * 收紧为白名单  ② knife4j.enable=false，文档路径不再免登录
#   ③ SQL 日志由 debug 调回 info
# 不激活 prod 则三项一律不生效 —— 开发/演示行为与改动前一致。
Environment="SPRING_PROFILES_ACTIVE=prod"

# JDK 21（pom 的 <java.version>21</java.version>）。机器上若有多个 JDK，
# 这里写绝对路径最稳，别依赖 PATH —— 实测有机器默认 java 指向 17，起不来。
#
# ⚠️ 下面这行**必须**显式写 `$JAVA_OPTS`（独立成词、不带花括号），否则下面那行 Environment 是死配置：
#    systemd **不会**自动把 Environment= 的值塞进 ExecStart，只有显式引用才会展开；
#    而 `$FOO` 独立成词时按空白拆成 **0 个或多个**参数，JAVA_OPTS 为空时该词整个消失（不会留下空参数）。
#    依据：systemd.service(5) 的 ExecStart= 一节 ——
#    "Use $FOO as a separate word on the command line, in which case it will be replaced by
#     the value of the environment variable split at whitespace, resulting in zero or more arguments."
#    https://man.archlinux.org/man/systemd.service.5
#    ⚠️ 2026-09-25 修正：此前这里没引用 $JAVA_OPTS，于是内存上限与 -Duser.timezone **实际都没生效**
#    （JVM 用默认堆；时区若不是东八区，会直接影响看板趋势图与签到窗口判定 ——
#     本项目时间字段是 TIMESTAMP（无时区）+ LocalDateTime，见 CLAUDE.md 踩坑第 10 条）。
#    首次部署后请核对一次：systemctl show vcp -p ExecStart  与  ps -ef | grep vcp-boot
#
# --server.address=127.0.0.1：让后端只监听本机，8080 不直接暴露在网上（Nginx 在 127.0.0.1 上反代它，
#    见 deploy/nginx.conf 的 location /api/ 与「收口」一节）。这正是部署文档 4.4 的「做法①」。
#    若要临时从别的机器直连 8080（例如用开发口径看 /doc.html），把这一段删掉或改成 0.0.0.0。
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/vcp/vcp-boot-1.0.0.jar --server.address=127.0.0.1

Restart=on-failure
RestartSec=5s

# JVM 参数按机器内存调整；演示数据量小，512m 起步够用。
# 这行靠上面 ExecStart 里的 $JAVA_OPTS 才生效 —— 不写那个引用等于没配。
Environment="JAVA_OPTS=-Xms256m -Xmx512m -Duser.timezone=Asia/Shanghai"

# ⚠️ 它和 JAVA_OPTS 不是一回事，别删：JAVA_TOOL_OPTIONS 是 **JVM 自己认**的环境变量
#    （每次启动会往 stderr 打一行 "Picked up JAVA_TOOL_OPTIONS: ..."，属正常现象）。
#    这里显式置空，是为了挡住从调用方继承进来的同名变量，保证单元行为可预期。
Environment="JAVA_TOOL_OPTIONS="

# 优雅退出：SIGTERM 时 Spring 会先停内嵌 Tomcat 再退出
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vcp

# ---------- 安全加固（可选，按需放开） ----------
# 只允许写 /opt/vcp 与 /tmp，其余文件系统只读
# ProtectSystem=full
# ProtectHome=true
# PrivateTmp=true
# NoNewPrivileges=true

[Install]
WantedBy=multi-user.target