# 开发环境
# 后端未就绪，走本地 mock（src/mock）。接口契约与真实后端一致，
# 后端起来后把 VITE_USE_MOCK 改成 false 即可切过去。
VITE_API_BASE_URL=/api
VITE_USE_MOCK=false

# dev server 的代理目标，见 vite.config.js 的 server.proxy。
# 可选，不设时默认 http://127.0.0.1:8080，即各人跑各自的本机后端。
# 要和别人联调时，把下面这行放进 .env.local（已被 .gitignore 忽略）覆盖：
#   VITE_API_TARGET=http://<对方机器>:8080
# 不要把某个人的内网 IP 写进这个要入库的文件。
